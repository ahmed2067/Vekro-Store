# Copy to .env locally or set these as secret environment variables on your host.
PORT=3000
# Use the API host specified by Safka's official API dashboard/docs.
SAFKA_API_BASE_URL=
# Keep the API key server-side only. Never put it in public HTML/JS.
SAFKA_API_KEY=
# Exact endpoint paths from Safka docs, including the /api/v1/public prefix.
SAFKA_PRODUCTS_PATH=
SAFKA_CREATE_ORDER_PATH=
