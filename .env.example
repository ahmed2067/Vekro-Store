PORT=3000
NODE_ENV=production
# Supabase PostgreSQL connection string; keep private and set only in hosting environment
DATABASE_URL=
# Random server-only signing secret (32+ chars)
SESSION_SECRET=
# Admin credentials, configured only in hosting environment
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Safka settings - never put the API key in frontend files
SAFKA_API_BASE_URL=
SAFKA_API_KEY=
# Exact endpoint path copied from Safka's current API docs
SAFKA_PRODUCTS_PATH=
